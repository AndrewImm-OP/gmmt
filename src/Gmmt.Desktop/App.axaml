<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gmmt.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ══════════ Global custom styles ══════════ -->

        <!-- Card style for Border elements -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1CFFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #20000000"/>
        </Style>

        <!-- Section header text -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#BBFFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Field label -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <!-- Primary action button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5B8DEF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#6D9CF5"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#55FFFFFF"/>
        </Style>

        <!-- Subtle/ghost button -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>

        <!-- Browse button -->
        <Style Selector="Button.browse">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.browse:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>

        <!-- Danger button -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#44E05252"/>
            <Setter Property="Foreground" Value="#FFEE88"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#55E05252"/>
        </Style>

        <!-- Badge styles -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.badge-success">
            <Setter Property="Background" Value="#2240C057"/>
            <Setter Property="BorderBrush" Value="#4440C057"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.badge-error">
            <Setter Property="Background" Value="#22E05252"/>
            <Setter Property="BorderBrush" Value="#44E05252"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.badge-warn">
            <Setter Property="Background" Value="#22E0A830"/>
            <Setter Property="BorderBrush" Value="#44E0A830"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.badge-info">
            <Setter Property="Background" Value="#225B8DEF"/>
            <Setter Property="BorderBrush" Value="#445B8DEF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Stat value (big number) -->
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
        </Style>

        <!-- Log panel -->
        <Style Selector="TextBox.log-panel">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="#BBCCBB"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="Cascadia Code,JetBrains Mono,Consolas,Menlo,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

    </Application.Styles>
</Application>
