<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- Suppress noisy warnings for extern/UndertaleModTool projects -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('extern'))">
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS8618;CA2022;NU1902;NU1903;NU1901</NoWarn>
    <FodyWeaversGenerateXsd>false</FodyWeaversGenerateXsd>
  </PropertyGroup>
</Project>
